#!/usr/bin/env ruby
#
# Generate changelogs using Git history and LLM summaries.
# With -p, includes full diff hunks in the prompt for richer summaries.
#
# Usage:
#   changes pending [-r vX.Y.Z] [-p]  # Show changes since last version
#   changes current [-p]              # Show changes between two latest versions
#   changes range v1.0.0..v1.2.0 [-p] # Show changes in a specific range
#   changes full [-p]                 # Generate full changelog from first tag
#   changes add CHANGELOG.md [-p]     # Append new entries to existing file
#
#   -r <tag>  Override the version label in the header (pending only)
#   -p        Include git diff hunks in the LLM prompt
#
# Requires:
#   - Git repository with version tags (vX.Y.Z format)
#   - Ollama server running locally or accessible via OLLAMA_URL / OLLAMA_HOST
#   - Configuration files in ~/.config/changes/
#     - system.txt: System prompt for LLM
#     - prompt.txt: Template for changelog generation
#
# Environment variables:
#   OLLAMA_URL:  Base URL of Ollama server OR
#   OLLAMA_HOST: Host of Ollama server
#   OLLAMA_MODEL: Model to use (default: llama3.1)
#   OLLAMA_CLIENT: JSON client configuration
#   OLLAMA_MODEL_OPTIONS: JSON model options
#   XDG_CONFIG_HOME: Custom config directory location
#   DEBUG: Set to 1 for verbose output

require 'ollama'
include Ollama
require 'utils'
include Utils::XDG
require 'tins/go'
include Tins::GO

# Executes a shell command and returns its output.
#
# This method runs the provided command in a shell environment and captures its
# standard output. If the command fails (returns a non-zero exit status), it
# raises an exception with details about the failure.
#
# @param cmd [ String ] the shell command to be executed
#
# @return [ String ] the standard output of the executed command
#
# @raise [ RuntimeError ] if the executed command returns a non-zero exit status
def x(cmd)
  output = `#{cmd}`
  $?.success? or fail "failed to execute #{cmd.inspect}"
  output
end

# Finds the highest version tag from a CHANGES file by parsing version strings
# in YYYY-MM-DD vMAJOR.MINOR.PATCH format.
#
# This method reads through the specified file line by line, extracting version
# tags that match the pattern "## YYYY-MM-DD vMAJOR.MINOR.PATCH" and determines
# the highest version number among them.
#
# @param filename [ String ] the path to the file containing version tags
#
# @return [ String, nil ] the highest version string found in the file, or nil
# if no valid version tags are present
def find_highest_version_tag(filename)
  File.open(filename, ?r) do |input|
    tags = []
    input.each do |line|
      line.scan(/^## \d{4}-\d{2}-\d{2} v(\d+\.\d+\.\d+)$/) do
        tags << $1
      end
    end
    tags.map(&:version).max
  end
end

# Normalizes a version tag to ensure it carries a `v` prefix.
#
# If the tag matches a bare semver pattern (e.g. `1.2.3`), a `v` is
# prepended. Tags that already carry the prefix (e.g. `v1.2.3`) or
# that don't look like a version (e.g. `HEAD`) are returned as-is.
#
# @param tag [Object] the version tag to normalize
#
# @return [String] the tag with a guaranteed `v` prefix for bare versions
def version_tag(tag)
  tag.to_s.sub(/\Av?(\d+\.\d+\.\d+)\z/, 'v\1')
end

# The options method retrieves and parses model configuration options from the
# OLLAMA_MODEL_OPTIONS environment variable.
#
# This method fetches the OLLAMA_MODEL_OPTIONS environment variable, which is
# expected to contain a JSON-encoded hash of configuration parameters. If the
# variable is not set, it defaults to an empty hash. The JSON string is then
# parsed into a Ruby hash and converted into an Options object using the
# Options.from_hash class method.
#
# @return [ Options ] an Options object representing the parsed configuration parameters
def options
  Options.from_hash(JSON.parse(ENV.fetch('OLLAMA_MODEL_OPTIONS', '{}')))
end

# Generates a formatted changelog entry by processing Git logs and utilizing an
# LLM.
#
# This method calculates the commit range between two points, retrieves the
# date of the latest commit, and sends the log data to an Ollama-powered LLM to 
# generate a human-readable summary based on local configuration templates.
#
# @param range_from [Object] the starting point of the Git log (e.g., 'v1.0.0')
# @param range_to [Object] the ending point of the Git log (e.g., 'v1.1.0' or :HEAD)
# @param future_tag [String] optional override for the version label displayed 
#   in the resulting header; defaults to `range_to`
#
# @return [String] a formatted Markdown changelog entry including date and summary
def compute_change(range_from, range_to, future_tag: range_to, patch: false, context_length: 4096)
  range_from = version_tag(range_from)
  if range_to.to_s == 'HEAD'
    range = "#{range_from}..HEAD"
  else
    range_to = version_tag(range_to)
    range = "#{range_from}..#{range_to}"
  end

  max_log = (context_length * 0.8 * 4).to_i

  log = x("git log #{'-p ' if patch}#{range}")
  log = log.encode(Encoding::UTF_8, invalid: :replace, undef: :replace, replace: '')

  if log.size > max_log
    if patch
      warn "Diff too large for #{range} (#{log.size} > #{max_log}), retrying without -p."
      log = x("git log #{range}")
      log = log.encode(Encoding::UTF_8, invalid: :replace, undef: :replace, replace: '')
    end
    if log.size > max_log
      log = log[0, max_log] + "\n\n[log truncated]"
    end
  end

  date = x("git log -n1 --pretty='format:%cd' --date=short #{range_to}")

  if log.strip.empty?
    return <<~EOT

    ## #{date} #{version_tag(future_tag)}
    EOT
  end

  config        = XDG_CONFIG_HOME + 'changes'
  base_url      = Ollama.base_url(ENV['OLLAMA_URL'] || ENV.fetch('OLLAMA_HOST'))
  model         = ENV.fetch('OLLAMA_MODEL', 'llama3.1')
  system        = config.read('system.txt')
  prompt        = config.read('prompt.txt') + "\n\n#{log}\n"
  client_config = Client::Config[**JSON.parse(ENV.fetch('OLLAMA_CLIENT', '{}'))]
  client_config.base_url = base_url

  if ENV['DEBUG'].to_i == 1
    STDERR.puts "system:\n#{system}"
    STDERR.puts "prompt:\n#{prompt}"
  end

  ollama  = Client.configure_with(client_config)
  changes = ollama.generate(model:, system:, prompt:, options:, stream: false, think: false)
  changes = changes.response.gsub(/\t/, '  ')

  return <<~EOT

    ## #{date} #{version_tag(future_tag)}

    #{changes}
  EOT
end

x("git fetch --tags")

opts           = go('pr:m:', defaults: { ?m => options.num_ctx })
context_length = opts[?m].to_i.nonzero? || 4_096

case command = ARGV.shift
when 'pending'
  last_version = x("git tag").lines.grep(/^v?\d+\.\d+\.\d+$/).map(&:chomp).map {
    _1.sub(/\Av/, '').version
  }.max
  if last_version
    puts compute_change(last_version, :HEAD, future_tag: opts[?r], patch: opts[?p], context_length:)
  else
    fail 'need at least one version tag to work'
  end
when 'current'
  version1, version2 = x("git tag").lines.grep(/^v?\d+\.\d+\.\d+$/).map(&:chomp).map {
    _1.sub(/\Av/, '').version
  }.sort.last(2)
  if version1 and version2
    puts compute_change(version1, version2, patch: opts[?p], context_length:)
  else
    fail 'need at least two version tags to work'
  end
when 'range'
  range = ARGV.shift
  if range =~ /\A(.+)\.\.(.+)\z/
    range_from, range_to = $1, $2
    puts compute_change(range_from, range_to, patch: opts[?p], context_length:)
  else
    fail "need range of the form v1.2.3..v1.2.4"
  end
when 'full', 'add'
  ary = []
  tags = x("git tag").lines.grep(/^v?\d+\.\d+\.\d+$/).map(&:chomp).map {
    _1.sub(/\Av/, '').version
  }.sort
  if command == 'full'
    date = x("git log -n1 --pretty='format:%cd' --date=short v#{tags.first}").chomp
    ary << <<~EOT

      ## #{date} v#{tags.first}

        * Start
    EOT
    tags.each_cons(2).with_infobar(label: 'Change', output: STDERR, show: STDERR.tty?) do |range_from, range_to|
      ary << compute_change(range_from, range_to, patch: opts[?p], context_length:)
      +infobar
    end
    ary.reverse!
    ary.unshift <<~EOT
      # Changes
    EOT
    puts ary
  else
    filename = ARGV.shift or fail 'need file to add to'
    start_tag = find_highest_version_tag(filename)
    tags = tags.drop_while { |t| t < start_tag }
    ary = []
    tags.each_cons(2).with_infobar(label: 'Change', output: STDERR, show: STDERR.tty?) do |range_from, range_to|
      ary << compute_change(range_from, range_to, patch: opts[?p], context_length:)
      +infobar
    end
    ary.empty? and exit
    ary.reverse!
    File.open(filename) do |input|
      File.secure_write(filename) do |output|
        start_add = nil
        input.each do |line|
          if start_add.nil? && line =~ /^# Changes$/
            start_add = true
            output.puts line
            next
          end
          if start_add && line =~ /^$/
            ary.each do |change|
              STDERR.puts change
              output.puts change
            end
            output.puts line
            start_add = false
            next
          end
          output.puts line
        end
      end
    end
  end
else
  puts <<~EOT
    Usage: #{File.basename($0)} help|range|full|add|pending

    Commands:
      pending        Show changes since last version tag
      current        Show changes between two latest version tags
      range <range>  Show changes for a specific Git range (e.g., v1.0.0..v1.2.0)
      full           Generate complete changelog from first tag
      add <file>     Append new entries to existing changelog file

  EOT
end
